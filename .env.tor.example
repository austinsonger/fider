# Fider Tor Hidden Service Configuration
# Copy this file to .env.tor and customize the values

# ======================
# CRITICAL SECURITY SETTINGS
# ======================

# Your onion address (will be generated automatically on first run)
# Replace with your actual .onion address after first startup
ONION_ADDRESS=your-generated-address.onion
BASE_URL=http://your-generated-address.onion

# Strong JWT secret - CHANGE THIS!
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG

# Database password - CHANGE THIS!
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD

# ======================
# APPLICATION SETTINGS
# ======================

# Environment
GO_ENV=production
HOST_MODE=single
PORT=3000

# Database connection
DATABASE_URL=postgres://fider:${POSTGRES_PASSWORD}@postgres:5432/fider?sslmode=require

# ======================
# TOR PROXY SETTINGS
# ======================

# Proxy configuration for outbound connections
HTTP_PROXY=socks5://tor:9050
HTTPS_PROXY=socks5://tor:9050
NO_PROXY=localhost,127.0.0.1,postgres,tor

# ======================
# SECURITY HARDENING
# ======================

# Disable external OAuth providers (they won't work over Tor anyway)
OAUTH_GOOGLE_CLIENTID=
OAUTH_FACEBOOK_APPID=
OAUTH_GITHUB_CLIENTID=

# Disable external email services
EMAIL_TYPE=disabled
EMAIL_NOREPLY=noreply@localhost

# Use SQL blob storage (no external S3)
BLOB_STORAGE=sql

# Disable metrics collection
METRICS_ENABLED=false

# Security headers
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=false

# ======================
# OPTIONAL SETTINGS
# ======================

# Signup control
SIGNUP_DISABLED=false

# Maintenance mode
MAINTENANCE=false
MAINTENANCE_MESSAGE=Service temporarily unavailable for maintenance
MAINTENANCE_UNTIL=

# Logging
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_SQL=false
LOG_FILE=true
LOG_FILE_OUTPUT=/app/logs/fider.log

# Locale
LOCALE=en

# ======================
# ADVANCED TOR SETTINGS
# ======================

# Tor control password (optional, for advanced users)
# TOR_CONTROL_PASSWORD=

# Additional Tor configuration (optional)
# TOR_EXTRA_CONFIG=

# ======================
# DEVELOPMENT SETTINGS
# ======================
# Uncomment for development/testing

# GO_ENV=development
# LOG_LEVEL=DEBUG
# LOG_SQL=true

# ======================
# EMAIL SETTINGS (if needed)
# ======================
# Only enable if you have a local SMTP server
# EMAIL_TYPE=smtp
# EMAIL_SMTP_HOST=mailhog
# EMAIL_SMTP_PORT=1025
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_ENABLE_STARTTLS=false
